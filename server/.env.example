# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/rembrio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rembrio
MONGODB_URI=mongodb://127.0.0.1:27017/rembrio

# ---- Auth ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_16_chars_long
JWT_EXPIRES_IN=7d

# ---- Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# Must equal numDimensions in the Atlas vector index.
EMBEDDING_DIMENSIONS=768
AI_TIMEOUT_MS=45000

# ---- Vector search ----
# local = exact cosine search in Node (plain MongoDB, development only)
# atlas = MongoDB Atlas Vector Search ($vectorSearch) — run `npm run create-vector-index` once
VECTOR_BACKEND=local
VECTOR_INDEX_NAME=rembrio_chunks_vector

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ---- RAG tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=4
# Minimum cosine similarity for a chunk to be sent to Gemini (tune on your own documents)
RAG_MIN_SCORE=0.45
