# Optional. In development the Vite dev server proxies /api to http://localhost:5000, so this can stay empty.
# Set it when the API is hosted on another origin (it must end in /api), e.g.:
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=
# Optional: where the dev proxy forwards /api (default http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000
